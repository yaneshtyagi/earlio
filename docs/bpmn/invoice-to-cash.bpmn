<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_earlio" targetNamespace="https://earlio.example/bpmn" exporter="Earlio docs" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_earlio">
    <bpmn:participant id="Participant_earlio" name="Earlio: invoice to cash (bank financing route)" processRef="Process_invoice_to_cash" />
  </bpmn:collaboration>
  <bpmn:process id="Process_invoice_to_cash" name="Invoice to cash" isExecutable="false">
    <bpmn:documentation>Happy path of an invoice financed by a bank, with the main exits. Drawn from apps/api (services, invoice state machine, worker). See docs/workflows.md for the detailed workflows.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_sup" name="Supplier">
        <bpmn:documentation>FinanceUser creates, submits, requests funding and selects; Approver consents.</bpmn:documentation>
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fund_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_consent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_buy" name="Buyer">
        <bpmn:documentation>Approver accepts the invoice and acknowledges the assignment; FinanceUser pays.</bpmn:documentation>
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_overdue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_plt" name="Earlio platform">
        <bpmn:documentation>Automatic steps: domain checks, outbox event handlers and worker jobs.</bpmn:documentation>
        <bpmn:flowNodeRef>t_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cover_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_noteligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_disburse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_credited</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ins" name="Insurer">
        <bpmn:documentation>Underwriter decides cover.</bpmn:documentation>
        <bpmn:flowNodeRef>t_underwrite</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_bnk" name="Bank">
        <bpmn:documentation>CreditOfficer prices offers and confirms financing.</bpmn:documentation>
        <bpmn:flowNodeRef>t_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_claimclosed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Goods shipped">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_create" name="Create draft invoice and attach documents">
      <bpmn:documentation>By hand, CSV or ERP import. Commercial invoice and delivery proof are required.</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_submit" name="Submit invoice to buyer">
      <bpmn:documentation>FinanceUser.</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_validate" name="Check documents, relationship and buyer; screen buyer">
      <bpmn:documentation>submitInvoice: documents present, relationship active, buyer KYC-approved and not blocked, sanctions screening.</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_valid" name="Checks pass?">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_refused" name="Submission refused">
      <bpmn:documentation>The reason is shown to the supplier.</bpmn:documentation>
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t_review" name="Review invoice">
      <bpmn:documentation>Approver. Silence is never acceptance; the worker sends reminders.</bpmn:documentation>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_decide" name="Decision?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_rejected" name="Invoice rejected">
      <bpmn:documentation>A reason is required.</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t_accept" name="Accept and sign payment undertaking">
      <bpmn:documentation>Full or partial acceptance; locks the amount and starts the dispute window.</bpmn:documentation>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="g_split">
      <bpmn:documentation>invoice.accepted event.</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="t_cover_req" name="Request insurance cover">
      <bpmn:documentation>requestCover, from the insurer on the relationship.</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_fund_req" name="Request funding">
      <bpmn:documentation>FinanceUser.</bpmn:documentation>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_underwrite" name="Underwrite cover">
      <bpmn:documentation>Approve (reserves buyer-limit headroom, may be partial) or decline. Valid 30 days.</bpmn:documentation>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_gates" name="Run funding gates 1 to 4">
      <bpmn:documentation>Parties verified, relationship active, invoice accepted, dispute window elapsed.</bpmn:documentation>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_eligible" name="Eligible?">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_noteligible" name="Not eligible">
      <bpmn:documentation>Invoice NotEligible with reasons; the supplier can re-check later.</bpmn:documentation>
      <bpmn:incoming>f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_invite" name="Invite preferred and partner banks">
      <bpmn:documentation>Invoice OpenForFunding.</bpmn:documentation>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_offer" name="Price and send offer">
      <bpmn:documentation>Gates 5 to 7 per bank: terms, exposure limits, cover. Shows annualised cost, net cash and FX rate.</bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="g_join">
      <bpmn:documentation>Offers in and cover decided.</bpmn:documentation>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="t_select" name="Compare and select offer">
      <bpmn:documentation>FinanceUser.</bpmn:documentation>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_reserve" name="Reserve bank limits and lien">
      <bpmn:documentation>Financing request ConsentPending; lien Reserved. A parallel selection fails with a lien conflict.</bpmn:documentation>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_consent" name="Consent to assignment and terms">
      <bpmn:documentation>Approver. Cooling-off cancellation is possible until payment is instructed.</bpmn:documentation>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_ack" name="Acknowledge assignment notice">
      <bpmn:documentation>Approver.</bpmn:documentation>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_confirm" name="Confirm financing">
      <bpmn:documentation>Re-checks sanctions, KYC, gates, cover and the buyer acknowledgement.</bpmn:documentation>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_disburse" name="Book FX and disburse to supplier">
      <bpmn:documentation>Value date from the bank cut-off and calendar; up to 3 attempts.</bpmn:documentation>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_credited" name="Credited?">
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_failed" name="Financing failed">
      <bpmn:documentation>Reversed; limits, lien and cover released; the supplier can choose again.</bpmn:documentation>
      <bpmn:incoming>f28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_complete" name="Complete funding">
      <bpmn:documentation>Lien Active, limits and cover consumed, invoice Funded, payment reference issued.</bpmn:documentation>
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_pay" name="Pay invoice on due date">
      <bpmn:documentation>Using the unique payment reference.</bpmn:documentation>
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="b_overdue" name="Due date passed" attachedToRef="t_pay">
      <bpmn:documentation>Invoice Overdue; default clock starts.</bpmn:documentation>
      <bpmn:outgoing>f34</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_overdue" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="t_match" name="Match payment and distribute">
      <bpmn:documentation>Principal to the bank, retention to the supplier, platform fee. Exceptions go to Operations.</bpmn:documentation>
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_reconcile" name="Reconcile with bank statement">
      <bpmn:documentation>Invoice Settled, then Closed.</bpmn:documentation>
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_closed" name="Invoice closed">
      <bpmn:incoming>f33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="s_claim" name="Default, claim and recovery">
      <bpmn:documentation>Waiting period, claim filed by the bank, decided and paid by the insurer, recoveries and recourse.</bpmn:documentation>
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="e_claimclosed" name="Closed after claim">
      <bpmn:incoming>f35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_create" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_create" targetRef="t_submit" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_submit" targetRef="t_validate" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_validate" targetRef="g_valid" />
    <bpmn:sequenceFlow id="f5" name="No" sourceRef="g_valid" targetRef="e_refused" />
    <bpmn:sequenceFlow id="f6" name="Yes" sourceRef="g_valid" targetRef="t_review" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_review" targetRef="g_decide" />
    <bpmn:sequenceFlow id="f8" name="Reject" sourceRef="g_decide" targetRef="e_rejected" />
    <bpmn:sequenceFlow id="f9" name="Accept" sourceRef="g_decide" targetRef="t_accept" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_accept" targetRef="g_split" />
    <bpmn:sequenceFlow id="f11" sourceRef="g_split" targetRef="t_cover_req" />
    <bpmn:sequenceFlow id="f12" sourceRef="g_split" targetRef="t_fund_req" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_cover_req" targetRef="t_underwrite" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_fund_req" targetRef="t_gates" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_gates" targetRef="g_eligible" />
    <bpmn:sequenceFlow id="f16" name="No" sourceRef="g_eligible" targetRef="e_noteligible" />
    <bpmn:sequenceFlow id="f17" name="Yes" sourceRef="g_eligible" targetRef="t_invite" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_invite" targetRef="t_offer" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_offer" targetRef="g_join" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_underwrite" targetRef="g_join" />
    <bpmn:sequenceFlow id="f21" sourceRef="g_join" targetRef="t_select" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_select" targetRef="t_reserve" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_reserve" targetRef="t_consent" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_consent" targetRef="t_ack" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_ack" targetRef="t_confirm" />
    <bpmn:sequenceFlow id="f26" sourceRef="t_confirm" targetRef="t_disburse" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_disburse" targetRef="g_credited" />
    <bpmn:sequenceFlow id="f28" name="No" sourceRef="g_credited" targetRef="e_failed" />
    <bpmn:sequenceFlow id="f29" name="Yes" sourceRef="g_credited" targetRef="t_complete" />
    <bpmn:sequenceFlow id="f30" sourceRef="t_complete" targetRef="t_pay" />
    <bpmn:sequenceFlow id="f31" sourceRef="t_pay" targetRef="t_match" />
    <bpmn:sequenceFlow id="f32" sourceRef="t_match" targetRef="t_reconcile" />
    <bpmn:sequenceFlow id="f33" sourceRef="t_reconcile" targetRef="e_closed" />
    <bpmn:sequenceFlow id="f34" sourceRef="b_overdue" targetRef="s_claim" />
    <bpmn:sequenceFlow id="f35" sourceRef="s_claim" targetRef="e_claimclosed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_earlio">
      <bpmndi:BPMNShape id="Participant_earlio_di" bpmnElement="Participant_earlio" isHorizontal="true"><dc:Bounds x="160" y="80" width="4190" height="1100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_sup_di" bpmnElement="L_sup" isHorizontal="true"><dc:Bounds x="190" y="80" width="4160" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_buy_di" bpmnElement="L_buy" isHorizontal="true"><dc:Bounds x="190" y="300" width="4160" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_plt_di" bpmnElement="L_plt" isHorizontal="true"><dc:Bounds x="190" y="520" width="4160" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_ins_di" bpmnElement="L_ins" isHorizontal="true"><dc:Bounds x="190" y="740" width="4160" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_bnk_di" bpmnElement="L_bnk" isHorizontal="true"><dc:Bounds x="190" y="960" width="4160" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="282" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="255" y="183" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_create_di" bpmnElement="t_create"><dc:Bounds x="395" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_submit_di" bpmnElement="t_submit"><dc:Bounds x="545" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_validate_di" bpmnElement="t_validate"><dc:Bounds x="695" y="560" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_valid_di" bpmnElement="g_valid" isMarkerVisible="true"><dc:Bounds x="875" y="575" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="855" y="543" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_refused_di" bpmnElement="e_refused"><dc:Bounds x="1032" y="672" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1005" y="713" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_review_di" bpmnElement="t_review"><dc:Bounds x="995" y="340" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_decide_di" bpmnElement="g_decide" isMarkerVisible="true"><dc:Bounds x="1175" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1155" y="323" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_rejected_di" bpmnElement="e_rejected"><dc:Bounds x="1332" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1305" y="493" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_accept_di" bpmnElement="t_accept"><dc:Bounds x="1295" y="340" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_split_di" bpmnElement="g_split"><dc:Bounds x="1475" y="575" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_cover_req_di" bpmnElement="t_cover_req"><dc:Bounds x="1595" y="650" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_fund_req_di" bpmnElement="t_fund_req"><dc:Bounds x="1595" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_underwrite_di" bpmnElement="t_underwrite"><dc:Bounds x="1745" y="780" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_gates_di" bpmnElement="t_gates"><dc:Bounds x="1745" y="560" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_eligible_di" bpmnElement="g_eligible" isMarkerVisible="true"><dc:Bounds x="1925" y="575" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1905" y="543" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_noteligible_di" bpmnElement="e_noteligible"><dc:Bounds x="2082" y="672" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2055" y="713" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
